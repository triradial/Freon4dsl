{
  "name": "freon4dsl",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/core",
    "packages/core-svelte",
    "packages/meta",
    "packages/languages/study-configuration",
    "packages/server-crchub",
    "packages/webapp-crchub",
    "packages/languages/project-configuration",
    "packages/server-islr",
    "packages/webapp-islr"
  ],
  "scripts": {
    "rebuild": "npm run clean && npm install && npm run build",
    "rebuild-dev": "npm run clean && npm install && npm run build-dev",
    "clean": "rm -f package-lock.json && rm -rf node_modules/ && npm run clean --workspaces --if-present",
    "clean-all": "npm run clean-all --workspaces --if-present",
    "start": "npm run start --stream --parallel",
    "build": "npm run build --workspaces --if-present",
    "build-dev": "npm run build-dev --workspaces --if-present",
    "build-release": "npm run build-release --workspaces --if-present",
    "build-samples": "npm run build-samples --workspaces --if-present",
    "clean-custom-samples": "npm run clean-custom --workspaces --if-present",
    "publish-local": "npm run publish-local --workspaces --if-present",
    "unpublish-local": "npm run unpublish-local --workspaces --if-present",
    "republish-local": "npm run unpublish-local && npm run publish-local",
    "install-local": "npm install --registry http://localhost:4873",
    "lint": "npm run lint --workspaces",
    "setup": "npm run setup --workspaces --if-present",
    "test": "npm run test --workspaces",
    "prettier": "prettier --write --print-width 180 --tab-width 4 packages/*/src/**/*.ts packages/*/src/**/*.tsx packages/*/src/**/*.css",
    "refreshTestStudies": "node refreshTestStudies.js",
    "dev": "npm run dev --workspaces --if-present",
    "format": "npm run format --workspaces",
    "check": "npm run check --workspaces",
    "preview": "npm run preview --workspaces",
    "repair-model-sync": "tsx scripts/repair-model-sync.ts"
  },
  "devDependencies": {
    "@prettier/sync": "^0.5.2",
    "@rollup/plugin-commonjs": "28.0.2",
    "@rollup/plugin-node-resolve": "16.0.0",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.1.2",
    "@sveltejs/adapter-auto": "^6.0.1",
    "@sveltejs/kit": "^2.25.1",
    "@sveltejs/package": "^2.4.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tsconfig/svelte": "5.0.4",
    "@types/dotenv": "^6.1.1",
    "@types/koa": "2.15.0",
    "@types/koa-bodyparser": "4.3.12",
    "@types/koa-router": "7.4.8",
    "@types/koa2-cors": "2.0.5",
    "@types/koa2-ratelimit": "0.9.6",
    "@types/lodash": "4.17.7",
    "@types/node": "^24.0.14",
    "@types/pegjs": "0.10.6",
    "@vitest/ui": "3.2.4",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^29.7.0",
    "cross-env": "7.0.3",
    "cssnano": "^7.0.6",
    "glob": "^11.0.0",
    "gulp": "^5.0.0",
    "gulp-postcss": "^10.0.0",
    "gulp-sass": "^5.1.0",
    "identity-obj-proxy": "3.0.0",
    "nodemon": "3.1.3",
    "peggy": "^4.0.3",
    "pegjs": "0.10.0",
    "prettier": "^3.6.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rollup": "4.22.0",
    "rollup-plugin-auto-external": "2.0.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-css-only": "4.5.2",
    "rollup-plugin-inject-process-env": "^1.3.1",
    "rollup-plugin-livereload": "2.0.5",
    "rollup-plugin-polyfill-node": "0.13.0",
    "rollup-plugin-svelte": "^7.2.2",
    "svelte-check": "^4.3.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.29.0",
    "vite": "^7.0.5",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^3.2.4",
    "vitest-tsconfig-paths": "^3.4.1"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.27.0",
    "@azure/storage-blob": "^12.25.0",
    "@azure/storage-file-share": "^12.25.0",
    "@freon4dsl/core": "2.0.0",
    "@freon4dsl/core-svelte": "2.0.0",
    "@internationalized/date": "^3.8.2",
    "@lucide/svelte": "^0.513.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tiptap/core": "^2.7.2",
    "@tiptap/pm": "^2.7.2",
    "@tiptap/starter-kit": "^2.7.2",
    "ag-grid-community": "^32.2.0",
    "ag-grid-enterprise": "^32.2.0",
    "bits-ui": "^2.8.10",
    "dotenv": "^16.4.5",
    "fs-extra": "^11.2.0",
    "koa": "2.13.1",
    "koa-bodyparser": "^4.3.0",
    "koa-router": "10.0.0",
    "koa2-cors": "2.0.6",
    "koa2-ratelimit": "^1.1.3",
    "lightningcss": "^1.30.1",
    "lodash": "^4.17.21",
    "mobx": "^6.12.3",
    "net.akehurst.language-agl-processor": "^4.2.1-20-RC2",
    "pegjs": "0.10.0",
    "phosphor-svelte": "^3.0.1",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  }
}
