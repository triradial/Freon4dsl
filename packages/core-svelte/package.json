{
  "publishConfig": {
    "access": "public"
  },
  "name": "@freon4dsl/core-svelte",
  "version": "1.1.0-beta.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freon4dsl/Freon4dsl.git"
  },
  "main": "dist/index.js",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run clean && vite build && npm run prepack",
    "build:verbose": "vite build --debug --logLevel debug && npm run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "build-dev": "tsc --noEmit && vite build && npm run prepack",
    "clean": "rm -rf dist",
    "build-release": "npm run build",
    "errors-only": "svelte-check --threshold error --tsconfig ./tsconfig.json",
    "install-local": "npm install --registry http://localhost:4873",
    "republish-local": "npm run unpublish-local && npm run publish-local",
    "release": "npm publish",
    "publish-local": "npm publish --registry http://localhost:4873",
    "unpublish-local": "npm unpublish --force --registry http://localhost:4873",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@material/web": "^2.2.0",
    "@skeletonlabs/skeleton": "^3.1.3",
    "@skeletonlabs/skeleton-svelte": "^1.2.3",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "publint": "^0.3.5",
    "svelte": "^5.0.0",
    "svelte-check": "^3.6.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@freon4dsl/core": "1.1.0-beta.3",
    "@lionweb/repository-client": "0.2.2",
    "@lionweb/validation": "0.6.2",
    "@lucide/svelte": "^0.513.0",
    "@material/slider": "^14.0.0",
    "@material/switch": "^14.0.0",
    "@material/web": "^2.2.0",
    "bits-ui": "^2.4.1",
    "debug": "^4.3.4",
    "lodash": "^4.17.21",
    "mobx": "^6.12.3",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.6.3"
  }
}
