{
  "name": "@freon4dsl/core",
  "version": "1.1.0-beta.3",
  "description": "The uttermost core part of the Freon library, which enables you to build editors for the web",
  "publishConfig": {
    "access": "public"
  }, 
  "license": "MIT",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freon4dsl/Freon4dsl.git"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "npm run build",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch",
    "format": "prettier --write .",
    "build-dev": "tsc --noEmit && vite build",
    "clean": "rm -rf node_modules/ && rm -rf dist/",
    "build-release": "npm run build",
    "errors-only": "tsc --noEmit",
    "install-local": "npm install --registry http://localhost:4873",
    "republish-local": "npm run unpublish-local && npm run publish-local",
    "release": "npm publish",
    "publish-local": "npm publish --registry http://localhost:4873",
    "unpublish-local": "npm unpublish --force --registry http://localhost:4873"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@material/web": "^2.2.0",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "publint": "^0.3.5",
    "svelte": "^5.0.0",
    "svelte-check": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@material/web": "^2.2.0",
    "@material/slider": "^14.0.0",
    "@material/switch": "^14.0.0",
    "mobx": "^6.12.0",
    "@lionweb/repository-client": "^0.2.2"
  }
}
