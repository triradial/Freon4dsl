{
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "name": "@freon4dsl/meta",
  "version": "1.1.0-beta.3",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freon4dsl/Freon4dsl.git"
  },
  "bin": {
    "freon": "dist/bin/freon-generator.js"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build --config vite.config.js",
    "preview": "vite preview",
    "format": "prettier --write .",
    "build-dev": "tsc --noEmit && vite build --config vite.config.js",
    "clean": "rm -rf node_modules/ && rm -rf dist/",
    "build-release": "npm run build",
    "install-local": "npm install --registry http://localhost:4873",
    "republish-local": "npm run unpublish-local && npm run publish-local",
    "release": "npm publish",
    "publish-local": "npm publish --registry http://localhost:4873",
    "unpublish-local": "npm unpublish --force --registry http://localhost:4873"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "globals": "^15.14.0",
    "publint": "^0.3.5",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-commonjs": "^0.10.4",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@freon4dsl/core": "1.1.0-beta.3",
    "@lionweb/validation": "^0.6.3",
    "@prettier/sync": "^0.5.2",
    "@rushstack/ts-command-line": "^4.22.0",
    "kotlin": "^1.5.21",
    "net.akehurst.language-agl-processor": "4.0.0-rc.5",
    "peggy": "^4.0.3",
    "pegjs": "0.10.0",
    "prettier": "^3.3.0",
    "source-map-support": "^0.5.21",
    "tslib": "^2.6.3"
  }
}
