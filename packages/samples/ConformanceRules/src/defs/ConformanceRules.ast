language ConformanceRulesModel

model ConformanceRulesModel {
    ruleCollection: RuleCollection;
}

modelunit RuleCollection {
    name: identifier;
    description: Description;
    rules: Rule[];
}

limited Sensitivity {
    dataset = { name: "Dataset" } other;
}

limited Executability {
    fullyExecutable = { name: "Fully Executable" }
    partiallyExecutable = { name: "Partially Executable" }
    notExecutable = { name: "Not Executable" }
}

limited RuleType {
    variableMetadataCheck = { name: "Variable Metadata Check" }
    dataStructureCheck = { name: "Data Structure Check" }
    datasetCheck = { name: "Dataset Check" }
}

concept Rule {
    name: identifier;
    organizations: Organization[];
    andOrIndicator: AndOrIndicator = AndOrIndicator:all;
    checkSet: CheckSet;
    core: Core;
    description: Description;
    executability: Executability;
    outcome: Outcome;
    ruleType: RuleType;
    scope: Scope;
    sensitivity: Sensitivity;
}

concept CheckSet {
    andOrIndicator: AndOrIndicator = AndOrIndicator:all;
    checks: CheckRule[];
}


limited CoreIdentifier {
    cdiscAdamigAd0014 = {name: "CDISC.ADaMIG.AD0014"}
    other = {name: "Other"}
}

limited CoreStatus {
    draft; approved; obsolete;
}

concept Core {
    coreId: CoreIdentifier;
    status: CoreStatus;
    version: string;
}

concept Organization {
    name: identifier; 
    standards: Standard[];
}

concept Standard {
    name: identifier;
    references: Reference[];
}

// the properties are placeholders for now...
concept Reference {
   citations: string;
   criteria: string;
   origin: string;
}

concept Outcome {
    message: string;
    outputVariables: OutputVariable[];
}

concept OutputVariable {
    variableName: identifier;
    variableLabel: string;
}

concept Scope {
    dataStructures: DataStructure[];
    datasets: Dataset[];
    domains: Domain[];
    subclasses: Subclass[];
}

limited IncludeKind {
    all = { name: "All" }
    none = { name: "None" }
    specific = { name: "Specific" }
}

abstract concept ScopeInclude {
    include: IncludeKind;
}

concept DataStructure base ScopeInclude {
}

concept Dataset base ScopeInclude {
}

concept Domain base ScopeInclude {
}

concept Subclass base ScopeInclude {
}

limited AndOrIndicator {
    all = {name: "ALL"} any = {name: "ANY"}
}

concept CheckRule {
    conformanceExpression: ConformanceExpression;
}

concept Description {
    text: string = " ";
    rawText: string = " ";
}
