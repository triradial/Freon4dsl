editor default

//boolean [YES | NO] // are the strings used to display a boolean value

RuleCollection {
  [
    Rule Collection Name: ${name}

    RULES
        ${rules}
  ]
}


Rule {
  [
    Description: ${description}

    AUTHORITIES
        ${organizations}

    ${checkSet}

    Core: 
      ${core}

    Executability: ${executability}

    Outcome: ${outcome}

    Rule Type: ${ruleType}

    Scope: ${scope}

    ---------

  ]
}

CheckSet {
  [
    CHECKS
      Rule passes if ${andOrIndicator} checks pass

          ${checks}
  ]
}

Core {
  [
    Id: ${coreId}
    Status: ${status}
    Version: ${version}
  ]
}

Organization {
  [
    organization: ${name}
    STANDARDS 
        ${standards}
  ]
}

Standard {
  [
    Name:${name}
    References:
        ${references}
  ]
}

Reference {
  [

    The details of the references go here, but aren't implemented yet...
    
  ]
}
CheckRule {
  [
    Check:  ${conformanceExpression} 
  ]
  trigger = "check"
}

Outcome {
    [
    Message:${message}
    OUTPUT VARIABLES
        ${outputVariables}
    ]
}

OutputVariable {
    [Name: ${variableName} Label:${variableLabel}]
}

Scope {
    [
    DataStructures:
      ${dataStructures}
    Datasets:
      ${datasets}
    Domains:
      ${domains}
    Subclasses:
      ${subclasses}
    ]
}

DataStructure {
  [
      include: ${include}
  ]
}

Dataset {
  [
      include: ${include}
  ]
}

Domain {
  [
    include: ${include}
  ]
}

Subclass {
  [include: ${include}]
}

Description {
  [
    ${text}
  ]
}