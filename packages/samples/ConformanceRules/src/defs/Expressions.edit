editor default

FieldNameExpression {
    ['${fieldName}']
    trigger = "field name"
}

MetaVariableExpression {
    [metadata variable:${functionName}]
    trigger = "metadata variable"
}

DefineVariableMetadata {
    [ ( Define Variable Metadata for ${attributeName} with id ${variableId} and target${targetVariableName} )]
    trigger = "define variable metadata"
}

DatasetNames {
    [( Dataset Names )]
    trigger = "dataset names"
}

Distinct {
    [Distinct for ${operationId} named: ${name} in domain ${domain} with group ${group}]
    trigger = "distinct"
}

DatasetMetadataCheck {
    [Dataset Metadata Check]
    trigger = "metadata check"
}

NumberLiteralExpression {
    [${value}]
    trigger = "number"
} 

YNLiteralExpression {
    [${value}]
    trigger = "y/n"
} 

GroupedExpression {
    [( ${inner} )]
    trigger = "() parenthesis"
}

NotExpression {
    [not]
    symbol = "not"
}

PlusExpression {
    symbol = "+"
}

MinusExpression {
    symbol = "-"
}

StringLiteralExpression {
    [\"${value}\"]
    trigger = "string"
}

ExistsExpression {
    ['${value}' exists]
    trigger = "exists"
}

BooleanLiteralExpression {
    [${value}]
    trigger = "true / false"
}

MultiplyExpression {
    symbol = "*"
}

DivideExpression {
    symbol = "/"
}

LessThenExpression {
    symbol = "<"
}

OrExpression {
    symbol = "or"
}

AndExpression {
    symbol = "and"
}

GreaterThenExpression {
    symbol = ">"
}

EqualsExpression {
    symbol = "=="
}

NotEqualsExpression {
    symbol = "^="
}


