language ConformanceRulesModel

abstract expression ConformanceExpression {
}

expression FieldNameExpression base ConformanceExpression {
    fieldName: string;
} 

expression NumberLiteralExpression base ConformanceExpression {
    value: number;
} 

expression BooleanLiteralExpression base ConformanceExpression {
    value: boolean;
}

limited YNChoice {
    y = { name: "Y"}
    n = { name: "N"}
}

expression GroupedExpression base ConformanceExpression {
    inner: ConformanceExpression;
}

expression NotEqualsExpression base ConformanceExpression{
}

expression NotExpression base ConformanceExpression {
    priority = 20;
}

expression YNLiteralExpression base ConformanceExpression {
    value: YNChoice;
}

expression StringLiteralExpression base ConformanceExpression {
    value: string;
}

///////////////////////////////////
//    Binary Expressions
////////////////////////////////////

abstract binary expression BinaryExpression base ConformanceExpression {
    left: ConformanceExpression;
    right: ConformanceExpression;
}

binary expression MultiplyExpression base BinaryExpression {
    priority = 8;
}

binary expression PlusExpression base BinaryExpression {
     priority = 4;
}

binary expression MinusExpression base BinaryExpression {
    priority = 4;
}

binary expression DivideExpression base BinaryExpression {
    priority = 8;
}

binary expression AndExpression base BinaryExpression {
    priority = 1;
}

binary expression OrExpression base BinaryExpression {
    priority = 1;
}

abstract binary expression ComparisonExpression base BinaryExpression {
}

binary expression LessThenExpression base ComparisonExpression {
    priority = 2;
}

binary expression GreaterThenExpression base ComparisonExpression {
    priority = 2;
}

binary expression EqualsExpression base ComparisonExpression {
    priority = 2;
}


limited MetaVariable {
    dataset_location;
    dataset_name;
    dataset_size;
    define_dataset_class;
    define_dataset_is_non_standard;
    define_dataset_key_sequence;
    define_dataset_label;
    define_dataset_location;
    define_dataset_name;
    define_dataset_structure;
    define_variable_allowed_terms;
    define_variable_ccode;
    define_variable_codelist_coded_values;
    define_variable_data_type;
    define_variable_format;
    define_variable_has_codelist;
    define_variable_has_comment;
    define_variable_has_no_data;
    define_variable_is_collected;
    define_variable_label;
    define_variable_length;
    define_variable_mandatory;
    define_variable_name;
    define_variable_order_number;
    define_variable_origin_type;
    define_variable_role;
    define_variable_size;
    define_vlm_allowed_terms;
    define_vlm_ccode;
    define_vlm_codelist_coded_values;
    define_vlm_data_type;
    define_vlm_format;
    define_vlm_has_codelist;
    define_vlm_has_comment;
    define_vlm_has_no_data;
    define_vlm_is_collected;
    define_vlm_label;
    define_vlm_length;
    define_vlm_mandatory;
    define_vlm_name;
    define_vlm_order_number;
    define_vlm_origin_type;
    define_vlm_role;
    define_vlm_size;
    filename;
    library_variable_core;
    library_variable_data_type;
    library_variable_label;
    library_variable_name;
    library_variable_order_number;
    library_variable_role;
    row_number;
    variable_data_type;
    variable_format;
    variable_has_empty_values;
    variable_label;
    variable_name;
    variable_order_number;
    variable_size;
    variable_value;
    variable_value_length;
    }

expression MetaVariableExpression base ConformanceExpression {
    functionName: MetaVariable;
} 

expression DefineVariableMetadata base ConformanceExpression {
    attributeName : string;
    targetVariableName: string;
    variableId: string;
}

expression DatasetNames base ConformanceExpression {
}

expression Distinct base ConformanceExpression {
    operationId: string;
    name: string;
    domain?: string;
    group?: string;
}

expression DatasetMetadataCheck base ConformanceExpression {

}
