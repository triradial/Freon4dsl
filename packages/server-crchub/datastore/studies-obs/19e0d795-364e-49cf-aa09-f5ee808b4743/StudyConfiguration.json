      {
         "id": "ID-236",
         "classifier": {
            "language": "-key-StudyConfigurationModel",
            "version": "2023.1",
            "key": "-key-Description"
         },
         "properties": [
            {
               "property": {
                  "language": "-key-StudyConfigurationModel",
                  "version": "2023.1",
                  "key": "-key-Description-text"
               },
               "value": "<ul>\n<li>Attend patient appt with a copy of the informed consent for patient review</li>\n<li>PI or Sub-I to inform patient of the availability of clinical trial and treatment logistics</li>\n<li>Clinical research staff to explain in detail specifics of patient participation in clinical trial (i.e., why they are being asked to participate, who is overseeing/funding the study, what is being researched/answered from data, what tasks will the patient need to complete, how will the patient be billed for visits/treatment, patient&rsquo;s right to withdraw and HIPAA)</li>\n<li>Encourage patient to ask questions and reiterate information back to ensure patient understands</li>\n<li>If patient is unsure if they want to participate at the time of the visit, allow patient to take a copy of the consent home to review<br>\n<ul>\n<li>Provide business card and encourage the patient to follow-up with questions/determination within a few days</li>\n<li>Follow-up with the patient if they do not reach out with a final decision</li>\n</ul>\n</li>\n<li>Obtain patient signature and physician signature on informed consent form\n<ul>\n<li>Ensure all optional specimen collections are answered yes or no</li>\n<li>Obtain witness signature if applicable (can be a family member or clinic staff, no research team member can sign as a witness)</li>\n</ul>\n</li>\n<li>Once all signatures are obtained, provide patient with a copy of the signed consent form for their records</li>\n<li>Inform patient of any upcoming appts or research tasks needed to move forward with registration/randomization</li>\n</ul>"
            },
            {
               "property": {
                  "language": "-key-StudyConfigurationModel",
                  "version": "2023.1",
                  "key": "-key-Description-rawText"
               },
               "value": " "
            }
         ],
         "containments": [],
         "references": [],
         "annotations": [],
         "parent": "ID-235"
