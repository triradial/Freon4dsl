{
  "name": "@freon4dsl/server-crchub",
  "version": "2.0.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/triradial/CRCHub"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "model-server": "./dist/bin/start-server.js"
  },
  "scripts": {
    "clean": "rm -rf node_modules/ && rm -rf dist/",
    "cleanup": "bash ../../scripts/cleanup.sh",
    "start": "cross-env AZURE_ENVIRONMENT=local nodemon --watch 'src/**/*' -e ts,tsx --exec node ./dist/server/server-starter.js",
    "start:local": "cross-env AZURE_ENVIRONMENT=local nodemon --watch 'src/**/*' -e ts,tsx --exec node ./dist/server/server-starter.js",
    "start:dev": "cross-env AZURE_ENVIRONMENT=development nodemon --watch 'src/**/*' -e ts,tsx --exec node ./dist/server/server-starter.js",
    "start:staging": "cross-env AZURE_ENVIRONMENT=staging node dist/server/server-starter.js",
    "start:prod": "cross-env AZURE_ENVIRONMENT=production node dist/server/server-starter.js",
    "build": "tsc --build",
    "build-dev": "tsc --build",
    "build-verbose": "tsc --build --verbose --listFiles --listEmittedFiles",
    "build-release": "npm run build",
    "set-password": "node dist/scripts/set-user-password.js",
    "lint": "tslint -c ./tslint.json './src/**/*.ts*'",
    "release": "npm publish",
    "publish-local": "npm publish --registry http://localhost:4873",
    "unpublish-local": "npm unpublish --force --registry http://localhost:4873",
    "republish-local": "npm run unpublish-local && npm run publish-local",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/koa2-cors": "^2.0.5",
    "@types/koa2-ratelimit": "^0.9.6",
    "@vitest/ui": "^2.1.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "@azure/storage-blob": "^12.25.0",
    "@azure/storage-file-share": "^12.25.0",
    "@freon4dsl/core": "2.0.0",
    "@freon4dsl/study-configuration": "2.0.0",
    "@lionweb/validation": "^0.6.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/koa": "^2.13.4",
    "@types/pg": "^8.11.10",
    "bcryptjs": "^2.4.3",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "koa": "2.13.1",
    "koa-bodyparser": "^4.3.0",
    "koa-router": "10.0.0",
    "koa2-cors": "2.0.6",
    "koa2-ratelimit": "^1.1.3",
    "pg": "^8.13.1",
    "supertest": "^7.0.0",
    "tslib": "^2.6.3",
    "zod": "^3.22.4"
  }
}