editor default

////////////////////////////////////////////////////////////
// EVENT SCHEDULE {eventSchedule}
////////////////////////////////////////////////////////////
EventSchedule {
    [
        First scheduled ${eventStart replace=CustomActionsComponent placeholder="event start"}
        ${eventWindow replace=CustomActionsComponent placeholder="recommended window"}
        ${complianceWindow replace=CustomActionsComponent placeholder="compliance window"}
        ${eventTimeOfDay replace=CustomActionsComponent placeholder="time of day"}
        ${eventRepeat replace=CustomActionsComponent placeholder="repeat"}
    ] 
    trigger = "event schedule"
}

EventReference {
    [ ${event replace=CustomSelectComponent placeholder="event reference"} is ${eventState replace=CustomSelectComponent placeholder="event state"} ]
    referenceShortcut = ${event}
}

