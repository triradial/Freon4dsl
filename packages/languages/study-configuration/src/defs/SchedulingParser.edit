editor parser

////////////////////////////////////////////////////////////
// EVENT SCHEDULE {eventSchedule}
////////////////////////////////////////////////////////////
EventSchedule {
    [
        First scheduled ${eventStart} 
        ${eventWindow}
        ${complianceWindow}
        ${eventTimeOfDay}
        ${eventRepeat}
    ]    
} 

EventReference {
    [${event}${eventState} ]
}

////////////////////////////////////////////////////////////
// TIME UNITS
////////////////////////////////////////////////////////////

Days {
    [ ${count} ]
}

PlusTimeAmount {
    [ plus ${value}${unit} ]
}

MinusTimeAmount {
    [ minus ${value}${unit} ]
}

////////////////////////////////////////////////////////////
// EVENT START {eventStart}
////////////////////////////////////////////////////////////


StudyStart {
    [${dummyText} as the start day of the study] 
} 

Day {
    [ day ${startDay} ] 
}

When {
    [ when ${startWhen} [? ${timeAmount}]] 
}  


FirstDayOfStudy {
    [ on the start day of the study ${timeAmount} ]   
}

Baseline {
    [ on the baseline/start day of the study ${timeAmount} ]
}

Previous {
    [ when the previous event ${eventState} ${timeAmount} ] 
}
Unscheduled {
    [ on any day (an unscheduled event) ] 
}

AnyDay {
    [ on any day (an unscheduled event) ]
} 

Daily {
    [ daily ]
}

Weekly {
    [ weekly ] 
}

Monthly {
    [ monthly ]  
}

Forever {
    [ forever ] 
}

////////////////////////////////////////////////////////////
// RECOMMENDED WINDOW {eventWindow}
////////////////////////////////////////////////////////////

NoRecommendedWindow {
    [ with no recommended window ] 
}

RecommendedWindowOf {
    [ with a recommended window of ${daysBefore} day(s) before and ${daysAfter}day(s) after ] 
}

RecommendedBeforeOf {
    [ with a recommended window of ${daysBefore} day(s) before ] 
}

RecommendedAfterOf {
    [ with a recommended window of ${daysAfter}day(s) after ] 
}

////////////////////////////////////////////////////////////
// COMPLIANCE WINDOW {complianceWindow}
////////////////////////////////////////////////////////////

NoComplianceWindow {
    [ and no compliance window ] 
}

ComplianceWindowOf {
    [ and a compliance window of ${maxDaysBefore} additional day(s) before and ${maxDaysAfter}day(s) after ] 
}

ComplianceBeforeOf {
    [ and a compliance window of ${maxDaysBefore} day(s) before ] 
}

ComplianceAfterOf {
    [ and a compliance window of ${maxDaysAfter}day(s) after ] 
}

////////////////////////////////////////////////////////////
// REPEAT {repeatExpression}
////////////////////////////////////////////////////////////

RepeatEvery {
    [ every: ${repeatEvery} ]   
}

RepeatCondition {
    [ ${repeatUnit}  [? up to ${maxRepeats} times] [? until ${until} ]  ] 
} 

RepeatCount {
    [ ${repeatCount} time(s) ]  
} 

////////////////////////////////////////////////////////////
// EVENT TIME OF DAY {eventTimeOfDay}
////////////////////////////////////////////////////////////

BetweenTimes {
    [ starting by ${startTimeAsString replace=CustomTimePickerComponent} and ending by ${endTimeAsString replace=CustomTimePickerComponent} ]  
}   

StartingBy {
    [ starting by ${startTimeAsString replace=CustomTimePickerComponent} ]    
} 

EndingBy {
    [ ending by ${endTimeAsString replace=CustomTimePickerComponent} ]    
} 
