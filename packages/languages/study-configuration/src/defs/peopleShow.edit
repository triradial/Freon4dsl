editor peopleShow precedence 201

Step {
    [
        [fragment stepDetailsWithPeople wrap = ItemGroupComponent cssClass="type4" canDelete="true" canAdd="false" canExpand="true" isExpanded="false" selectable="false" label="Step"]
    ]
    fragment stepDetailsWithPeople [
        ${name}
        ${people wrap=ListGroupComponent cssClass="type3" canAdd="true" canExpand="true" canDelete="true" isExpanded="true" selectable="false" label="People"}
        ${description}
    ]
}
        // ${people table rows}

