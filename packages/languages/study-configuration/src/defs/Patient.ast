  language StudyConfigurationModel

modelunit Availability { //TODO: rename StaffAvailability
  name: identifier = "Availability";
  baselineStaff: string;
  staffLevels: StaffLevel[];
}

modelunit PatientInfo {  // TODO: Change to Patients 
  name: identifier;
  patientHistories: PatientHistory[];
}

// TODO: Remove this temporary hack to allow editing of a patient history for a patient in the database.
modelunit PatientHistoryUnit {
  patientHistory: PatientHistory;
}

concept PatientHistory {
  patient_id: string;// initials or whatever the specific study uses to identify the patient in a secure way; No sharing patients across studies
  id: string; // TODO: DELETE this and switch to patient_id; 
  startOfStudyDate: DateConcept;
  patientVisits: PatientVisit[];
  patientNotAvailableDates: DateRange[];
}

limited PatientVisitStatus {
  planned; completed; missed; canceled;
}

concept PatientVisit {
  name: identifier;
  reference visit: Event;
  visitInstanceNumber: number = 1;
  actualVisitDate: DateConcept;
  status: PatientVisitStatus = PatientVisitStatus:planned;
}

concept PatientNotAvailable {
    dates: DateRange[];
}

concept StaffLevel {
  staffAvailable: string;
  startDate: DateConcept;
  endDate?: DateConcept;

  dateOrRange: DateRange;
}

limited Month {
    January; February; March; April; May; June; July; August; September; October; November; December;
}

concept VisitDate {
  dateAsString: string;
  day: string;
  month: Month;
  year: string = "2025";
}

concept DateRange {
  startDate: DateConcept;
  endDate?: DateConcept;
}

// This is called DateConcept to avoid conflict with the TypeScript Date class. 
// It represents a date in the language.
// dataAsString is only here because the DatePicker component needs to set the date as a string. 
// DatePicker needs to be updated to directly set the day, month, year.
concept DateConcept {
  dateAsString: string;
  day: string;
  month: Month;
  year: string = "2025";
}