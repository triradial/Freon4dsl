editor default

global {
    external {
        DatePicker,
        TimePicker,
        ExpandCollapseWrapper
    }
}

Availability {
  [
    STAFFING
      Number of CRCs Normally Available: ${baselineStaff}

      Staffing Level Changes:
      ${staffLevels}

  ]
}

PatientNotAvailable {
  [
  ${dates}
  ]
}

StaffLevel {
  [ 
    # Staff: ${staffAvailable} on: ${dateOrRange}
  ] trigger = "Staff Level"
}

DateRange {
  [${startDate} thru:${endDate}]
}

DateConcept {
  [${dateAsString replace=DatePicker startDate="30/09/2024"}]
}


PatientInfo {
  [
   ${patientHistories}
  ]
}

PatientHistory {
  [
   ID ${patient_id} 
   Patient completed: 
   ${patientVisits} 
   Not Available ${patientNotAvailableDates}
  ]
}

PatientVisit {
  [
      Visit: '${visit}' on  ${actualVisitDate} 
  ] trigger = "Patient Visit"
}

PatientHistoryUnit {
  [
    ${patientHistory}
  ]
}