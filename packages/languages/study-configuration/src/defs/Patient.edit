editor default

Availability {
  [
    STAFFING
      Number of CRCs Normally Available: ${baselineStaff}

      Staffing Level Changes:
      ${staffLevels}

  ]
}

PatientNotAvailable {
  [
  ${dates}
  ]
}

StaffLevel {
  [ 
    # Staff: ${staffAvailable} on: ${dateOrRange replace=DateRangePickerComponent}
  ] trigger = "Staff Level"
}

DateRange {
  [
    [fragment dateRangeDetails wrap = SingleLineItemComponent cssClass="type3" canDelete="true" canAdd="false" canExpand="true" isExpanded="true" selectable="true" label="Dates"]
  ]
  fragment dateRangeDetails [
    ${startDate} thru:${endDate}
  ]
}

DateConcept {
  [${dateAsString replace=DatePickerComponent startDate="30/09/2024"}]
}


PatientInfo {
  [
   ${patientHistories}
  ]
}

PatientHistory {
  [
   ID ${patient_id} 
   ${patientVisits wrap=ListGroupComponent cssClass="type3" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="Patient Visits"} 
   ${patientNotAvailableDates wrap=ListGroupComponent cssClass="type3" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="Patient Not Available Dates"}
  ]
}

PatientVisit {
  [
      [fragment visitDetails wrap = SingleLineItemComponent cssClass="type3" canDelete="true" canAdd="false" canExpand="true" isExpanded="true" selectable="true" label="Visit"]
  ]
  fragment visitDetails [
    ${visit} On ${actualVisitDate}
  ]
}

PatientHistoryUnit {
  [
    ${patientHistory}
  ]
}