editor stepsShow precedence 106

Task {
    [
        [fragment taskDetailsWithSteps wrap = ItemGroupComponent cssClass="type4" canDelete="true" canDuplicate="true" canShare="true" canAdd="false" canExpand="true" isExpanded="false" selectable="false" label="Task"]
    ]
    fragment taskDetailsWithSteps [
        ${name} 
        ${description}
        ${steps wrap=ListGroupComponent cssClass="type4" canAdd="true" canDelete="true" canExpand="true" isExpanded="true" selectable="false" label="Steps"}
    ] 
}
