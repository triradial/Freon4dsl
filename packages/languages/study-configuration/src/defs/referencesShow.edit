editor referencesShow precedence 202

Step {
    [
        [fragment stepDetailsReferences wrap = ItemGroupComponent cssClass="type4" canDelete="true" canDuplicate="true" canAdd="false" canExpand="true" isExpanded="false" selectable="false" label="Step"]
    ]
    fragment stepDetailsReferences [
        ${name}
        ${description}
        ${references wrap=ListGroupComponent cssClass="type3" canAdd="true" canExpand="true" isExpanded="false" selectable="false" canDragAndDrop="false" label="References"}
    ]
}
