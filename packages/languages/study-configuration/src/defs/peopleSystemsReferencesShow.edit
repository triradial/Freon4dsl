editor peopleSystemsReferencesShow precedence 207

Step {
    [
        [fragment stepDetailsWithPeopleSystemsReferences wrap = ItemGroupComponent cssClass="type4" canDelete="true" canDuplicate="true" canAdd="false" canExpand="true" isExpanded="false" selectable="false" label="Step"]
    ]
    fragment stepDetailsWithPeopleSystemsReferences [
        ${name}
        ${description}
        ${people wrap=ListGroupComponent cssClass="type3" canAdd="true" canDelete="true" canExpand="true" isExpanded="false" selectable="false" canDragAndDrop="false" label="People"}
        ${systems wrap=ListGroupComponent cssClass="type3" canAdd="true" canDelete="true" canExpand="true" isExpanded="false" selectable="false" canDragAndDrop="false" label="Systems Used"}
        ${references wrap=ListGroupComponent cssClass="type3" canAdd="true" canDelete="true" canExpand="true" isExpanded="false" selectable="false" canDragAndDrop="false" label="References"}
    ]
}
