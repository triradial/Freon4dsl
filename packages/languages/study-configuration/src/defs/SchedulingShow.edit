editor schedulingShow precedence 100

Event {
    [
        Event: ${name}
        This is a ${typeOfEvent} that is also referred to as ${alternativeName}
        Type: 
        ${description}
        ${schedule wrap=ListGroupComponent cssClass="type3" canExpand="true" isExpanded="true" selectable="false" label="Schedule"}
    ] 
}


TimeAmount {
    [${value}${unit}]
}

TimeAmountPart {
    [${operator}${timeAmount}]
} 

Day {
    [ day ${startDay} ]
}

When {
    [ when ${startWhen} ${timeAmountPart}]
}  

StudyStart {
    [ as the start day of the study ${timeAmountPart} ] 
} 

FirstDayOfStudy {
    [ on the start day of the study ${timeAmountPart} ]
}

Baseline {
    [ on the baseline/start day of the study ${timeAmountPart} ]
}

Previous {
    [ when the previous event ${eventState} ${timeAmountPart} ]
}
Unscheduled {
    [ on any day (an unscheduled event) ]
}

AnyDay {
    [ on any day (an unscheduled event) ]
} 

Daily {
    [ daily ]
}

Weekly {
    [ weekly ]
}

Monthly {
    [ monthly ]
}

Forever {
    [ forever ]
}

RepeatEvery {
    [ every: ${repeatEvery} ]
}

RepeatCondition {
    [
    ${repeatUnit} up to ${maxRepeats} times until ${until}
    ]
} 

RepeatCount {
    [
        ${repeatCount} time(s)  
    ] 
} 

BetweenTimes {
    [
        starting by ${startTimeAsString replace=TimePickerComponent} and ending by ${endTimeAsString replace=TimePickerComponent}
    ] 
}   

StartingBy {
    [
        starting by ${startTimeAsString replace=TimePickerComponent}
    ] 
} 

EndingBy {
    [
        ending by ${endTimeAsString replace=TimePickerComponent}
    ] 
} 


NoComplianceWindow {
}

ComplianceWindowOf {
    [
         ${maxDaysBefore} additional day(s) before and ${maxDaysAfter}day(s) after
    ]
}

EventWindow {
    [
        ${daysBefore} day(s) before and ${daysAfter}day(s) after
        and a compliance window of: ${complianceWindow}
    ]
}

//RepeatExpression {
//    [${eventRepeat}]
//}

EventSchedule {
    [
        First scheduled ${eventStart}
        with a window of ${eventWindow}
        and then repeats ${eventRepeat}
        limited to ${eventTimeOfDay}
    ] 
} 


EventReference {
    [${event}${eventState} ]
    referenceShortcut = ${event}
    }

Days {
    [${count}]
}