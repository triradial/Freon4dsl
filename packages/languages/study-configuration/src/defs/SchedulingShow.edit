editor schedulingShow precedence 101

Event {
    [ 
        [fragment schedulingEventDetails wrap = ItemGroupComponent cssClass="type2" canDelete="true" canDuplicate="true" canExpand="true" isExpanded="false" selectable="false" label="Event"]
    ]
    fragment schedulingEventDetails [
        ${name}
        ${description}
        This is a ${typeOfEvent replace=CustomSelectComponent placeholder="event type"} that is also referred to as ${alternativeName}
        and is part of ${arm replace=CustomRefActionsComponent placeholder="every"} Arm 
        ${schedule wrap=ListGroupComponent cssClass="type3" canExpand="true" isExpanded="false" selectable="false" label="Schedule"}
    ]
}

