editor peopleReferencesShow precedence 205

Step {
    [
        [fragment stepDetailsWithPeopleReferences wrap = ItemGroupComponent cssClass="type4" canDelete="true" canAdd="false" canExpand="true" isExpanded="true" selectable="false" label="Step"]
    ]
    fragment stepDetailsWithPeopleReferences [
        ${name}
        ${description}
        ${people wrap=ListGroupComponent cssClass="type3" canAdd="true" canExpand="true" canDelete="true" isExpanded="true" selectable="false" label="People"}
        ${references wrap=ListGroupComponent cssClass="type3" canAdd="true" canExpand="true" canDelete="true" isExpanded="true" selectable="false" label="References"}
    ]
}
        // ${people table rows}
