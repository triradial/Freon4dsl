editor systemsReferencesShow precedence 206

Step {
    [
        [fragment stepDetailsWithSystemsReferences wrap = ItemGroupComponent cssClass="type4" canDelete="true" canAdd="false" canExpand="true" isExpanded="true" selectable="false" label="Step"]
    ]
    fragment stepDetailsWithSystemsReferences [
        ${name}
        ${description}
        ${systems wrap=ListGroupComponent cssClass="type3" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="Systems Used"}
        ${references wrap=ListGroupComponent cssClass="type3" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="References"}
    ]
}
