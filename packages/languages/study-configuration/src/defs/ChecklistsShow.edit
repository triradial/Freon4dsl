editor checklistsShow precedence 104

Event {
    [ 
        [fragment checklistEventDetails wrap=ItemGroupComponent cssClass="type2" canDelete="true" canDuplicate="true" canExpand="true" isExpanded="false" selectable="false" label="Event"]
    ]
    fragment checklistEventDetails [
        ${name}
        ${description}
        This is a ${typeOfEvent replace=CustomSelectComponent placeholder="event type"} that is also referred to as ${alternativeName}
        ${tasks wrap=ListGroupComponent cssClass="type3" canAdd="true" canDelete="true" canPasteMultiple="true" canExpand="true" isExpanded="false" selectable="false" label="Checklist"}
    ]
}

UnscheduledEvent {
    [
        [fragment unscheduledEventDetailsShow wrap = ItemGroupComponent cssClass="type2" canDelete="true" canDuplicate="true" canExpand="true" isExpanded="false" selectable="false" label="Event"]
    ]
    fragment unscheduledEventDetailsShow [
        ${name}
        This is a ${typeOfEvent replace=CustomSelectComponent placeholder="event"} that is also referred to as ${alternativeName}
        ${description}
        ${tasks wrap=ListGroupComponent cssClass="type3" canAdd="true" canDelete="true" canPasteMultiple="true" canExpand="true" isExpanded="false" selectable="false" label="Checklist"}
    ]
}

