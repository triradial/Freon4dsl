editor default

global {
    external {
        ListGroupComponent,
        ItemGroupComponent,
        DatePickerComponent,
        TimePickerComponent
    }
}

StudyConfiguration {
    [
    ${periods wrap=ListGroupComponent cssClass="type1" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="Study Periods"}
    ${tasks wrap=ListGroupComponent cssClass="type1" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="Tasks"}
    ${systemAccesses wrap=ListGroupComponent cssClass="type1" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="System Accesses"}
    ${staffing wrap=ListGroupComponent cssClass="type1" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="Staffing"}
    ]
}

//boolean [YES | NO] // are the strings used to display a boolean value

Period {
    [
        ${name}
        ${description}
        ${events wrap=ListGroupComponent cssClass="type1" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="Events"}
    ]
}

Event {
    [
        Event: ${name}
        This is a ${typeOfEvent} that is also referred to as ${alternativeName}
        Type: 
        Description: ${description}
        Schedule: 
            ${schedule wrap=ListGroupComponent cssClass="type3" canExpand="true" isExpanded="true" selectable="false" label="Schedule"}
        Checklist:
            ${tasks wrap=ListGroupComponent cssClass="type3" canExpand="true" isExpanded="true" selectable="false" label="Checklist"}
    ] 
}

Task {
    [
        ${name}
        ${description}
    ]
}

Step {
    [
        Step ${title} 
        Description: ${detailsDescription}
        References: ${references}
        Systems Used: ${systems table rows}
        People: ${people}
    ]
}

SystemAccess {
    table [ 
             System    
             ${name}
        ]
}

SystemAccessReference {
    [
        System: ${system}
    ]
}

AccessedAtURL {
    [
        URL: ${url}
    ]
}

AccessedAPhoneNumber {
    [
        Phone Number: ${phoneNumber}
    ]
}

Person {
    [
        Name: ${name}  ${useSystemContact} Use System Contact   Email: ${email}
                                                                Phone: ${phoneNumber}
                                                                Role : ${role} 
    ]
}

Staffing {
    [
        Roles: 
            ${roles}
        Assignments: 
            ${assignments}
    ]
}

Reference {
    [
        Reference Title: ${title}    Link: ${link}
        Description    : ${description}
    ]
}

Assignment {
    [
        Role  : ${role}
        Person: ${person}
    ]
}

StaffRole {
    [
        role: ${name}
    ]
}

WorkflowDescription {
    [
    Description: ${text}
    ]
    trigger = "description"
}

WorkflowBranch {
    [ Branch: ${branch}  ]
}

RobotMapping {
    [
    [fragment first] [fragment second]
    From this Page: ${sourcePage}
    To this Page :   ${targetPage}
    These fields:
        ${sourceToTargetMappings}
    ]
    fragment first [first]
    fragment second [second]

}

SourceToTargetMapping {
    [
        Source Field: ${sourceField}  Target Field: ${targetField}
    ]
}

Description {
   [ ${text} ]
}
