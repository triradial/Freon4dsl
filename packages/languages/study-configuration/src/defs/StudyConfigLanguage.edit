editor default

global {
    external {
        ListGroupComponent,
        ItemGroupComponent,
        ItemGroupComponent2,
        DatePickerComponent,
        TimePickerComponent,
        MultilineTextComponent,
        DisplayNothingComponent
    }
}

StudyConfiguration {
    [
    ${periods wrap=ListGroupComponent cssClass="type1" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="Study Periods"}
    ${systemAccesses wrap=ListGroupComponent cssClass="type1" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="System Accesses"}
    ${staffing wrap=ListGroupComponent cssClass="type1" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="Staffing"}
    ]
}

//boolean [YES | NO] // are the strings used to display a boolean value

Period {
    [ 
        [fragment periodDetails wrap = ItemGroupComponent cssClass="type1" canDelete="true" canDuplicate="true" canExpand="true" isExpanded="true" selectable="false" label="Period"]
    ]
    fragment periodDetails [
        ${description}
        ${events wrap=ListGroupComponent cssClass="type2" canAdd="true" canExpand="true" isExpanded="false" selectable="false" label="Events"}
    ]   
}

Event {
    [ 
        [fragment noEventDetails wrap = ItemGroupComponent cssClass="type2" canDelete="true" canDuplicate="true" canExpand="true" isExpanded="false" selectable="false" label="Event"]
    ]
    fragment noEventDetails [
       This is a ${typeOfEvent} that is also referred to as ${alternativeName}
        ${description}
    ]
}

Task {
    [
        [fragment taskDetails wrap = ItemGroupComponent cssClass="type3" canShare="true" canDelete="true" canDuplicate="true" canExpand="true" isExpanded="false" selectable="false" label="Shared Tasks"]
    ]
    fragment taskDetails [
        ${description}
        ${steps wrap=ListGroupComponent cssClass="type4" canAdd="true" canExpand="true" isExpanded="false" selectable="false" label="Steps"}
    ]
}

SharedTask {
    [
        [fragment sharedTaskDetails wrap = ItemGroupComponent cssClass="type3" canDelete="true" canDuplicate="true" canExpand="true" isExpanded="false" selectable="false" label="Task"]
    ]
    fragment sharedTaskDetails [
        ${description}
        ${steps wrap=ListGroupComponent cssClass="type4" canAdd="true" canExpand="true" isExpanded="false" selectable="false" label="Steps"}
    ]
}

TaskReference {
    [
        [fragment taskReferenceDetails wrap = ItemGroupComponent2 cssClass="type3" canDelete="true" canExpand="true" isExpanded="false" selectable="false" label="Task"]
    ]
    fragment taskReferenceDetails [
        ${task wrap=DisplayNothingComponent}  
        ${description}
        ${steps wrap=ListGroupComponent cssClass="type4" canAdd="true" canExpand="true" isExpanded="false" selectable="false" label="Steps"}
    ]

}

Step {
    [
        [fragment stepDetails wrap = ItemGroupComponent cssClass="type4" canAdd="true" canExpand="true" isExpanded="false" selectable="false" label="Step"]
    ]
    fragment stepDetails [
        ${detailsDescription}
        ${references wrap=ListGroupComponent cssClass="type5" canAdd="true" canExpand="true" isExpanded="false" selectable="false" label="References"   }
        Systems Used: ${systems table rows}
        ${people wrap=ListGroupComponent cssClass="type5" canAdd="true" canExpand="true" isExpanded="false" selectable="false" label="People"}
    ]
}

SystemAccess {
    table [ 
             System    
             ${name}
        ]
}

SystemAccessReference {
    [
        System: ${system}
    ]
}

AccessedAtURL {
    [
        URL: ${url}
    ]
}

AccessedAPhoneNumber {
    [
        Phone Number: ${phoneNumber}
    ]
}

Person {
    [
        Name: ${name}  ${useSystemContact} Use System Contact   Email: ${email}
                                                                Phone: ${phoneNumber}
                                                                Role : ${role} 
    ]
}

Staffing {
    [
        Roles: 
            ${roles}
        Assignments: 
            ${assignments}
    ]
}

Reference {
    [
        Reference Title: ${title}    Link: ${link}
        ${description}
    ]
}

Assignment {
    [
        Role  : ${role}
        Person: ${person}
    ]
}

StaffRole {
    [
        role: ${name}
    ]
}

WorkflowDescription {
    [
    Description: ${text}
    ]
    trigger = "description"
}

WorkflowBranch {
    [ Branch: ${branch}  ]
}

RobotMapping {
    [
    [fragment first] [fragment second]
    From this Page: ${sourcePage}
    To this Page :   ${targetPage}
    These fields:
        ${sourceToTargetMappings}
    ]
    fragment first [first]
    fragment second [second]

}

SourceToTargetMapping {
    [
        Source Field: ${sourceField}  Target Field: ${targetField}
    ]
}

Description {[<Description is Hidden>] }

