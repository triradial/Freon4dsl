editor default

global {
    external {
        ListGroupComponent,
        SingleLineItemComponent,
        DatePickerComponent,
        DateRangePickerComponent,
        MultilineTextComponent,
        DisplayNothingComponent,
        ReferenceComponent,
        UrlInputComponent,
        PhoneInputComponent,
        EmailInputComponent,
        ItemGroupComponent,
        CustomNumericComponent,
        CustomSelectComponent,
        CustomActionsComponent,
        CustomTimePickerComponent,
        TimePickerComponent,
        SelectableListItemComponent
    }
}

//boolean [YES | NO] // are the strings used to display a boolean value

StudyConfiguration {
    [
    ${periods wrap=ListGroupComponent cssClass="type1" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="Study Periods"}
    ${unscheduledEvents wrap=ListGroupComponent cssClass="type1" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="Study Unscheduled Events"}
    ${staffing wrap=ListGroupComponent cssClass="type1" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="Staff"}
    ${roles wrap=ListGroupComponent cssClass="type1" canAdd="true" canExpand="true" isExpanded="false" selectable="false" label="Roles"}
    ${description wrap=ListGroupComponent cssClass="type1" canAdd="false" canExpand="true" isExpanded="false" selectable="false" label="Study Notes"}
    ${sharedReferences wrap=ListGroupComponent cssClass="type1" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="Shared References"}
    ]
}

Period {
    [ 
        [fragment periodDetails wrap = ItemGroupComponent cssClass="type1" canDelete="true" canDuplicate="true" canExpand="true" isExpanded="true" selectable="false" label="Period"]
    ]
    fragment periodDetails [
        ${name}
        ${description}
        ${events wrap=ListGroupComponent cssClass="type2" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="Scheduled Events"}
        ${unscheduledEvents wrap=ListGroupComponent cssClass="type2" canAdd="true" canExpand="true" isExpanded="true" selectable="false" label="Unscheduled Events"}
    ]   
}

Event {
    [ 
        [fragment noEventDetails wrap = ItemGroupComponent cssClass="type2" canDelete="true" canDuplicate="true" canExpand="true" isExpanded="false" selectable="false" label="Event"]
    ]
    fragment noEventDetails [
       ${name}
       This is a ${typeOfEvent replace=CustomSelectComponent placeholder="event"} that is also referred to as ${alternativeName}
       ${description}
    ]
}

UnscheduledEvent {
    [
        [fragment unscheduledEventNoDetails wrap = ItemGroupComponent cssClass="type2" canDelete="true" canDuplicate="true" canExpand="true" isExpanded="false" selectable="false" label="Event"]
    ] trigger = "Unscheduled Event"
    fragment unscheduledEventNoDetails [
        ${name}
        This is a ${typeOfEvent replace=CustomSelectComponent placeholder="event"} that is also referred to as ${alternativeName}
        ${description}
    ]
}

Task {
    [
        [fragment taskDetails wrap = ItemGroupComponent cssClass="type4" canDelete="true" canDuplicate="true" canShare="true" canAdd="false" canExpand="true" isExpanded="false" selectable="false" label="Task"]
    ] trigger = "Task in this Checklist"
    fragment taskDetails [
        ${name} 
        ${description}
    ] 
}

TaskReference {
    [
        [fragment taskReferenceDetails wrap =  ReferenceComponent cssClass="type3" canDelete="true" canExpand="false" isExpanded="false" selectable="true" label="Task"]
    ] trigger = "Reference to Shared Task"
    fragment taskReferenceDetails [
        ${task}
    ]
}

Step {
    [
        [fragment stepDetails wrap = ItemGroupComponent cssClass="type4" canDelete="true" canDuplicate="true" canAdd="false" canExpand="true" isExpanded="false" selectable="false" label="Step"]
    ]
    fragment stepDetails [
        ${name}
        ${description}
    ]
}

SystemAccess {
    [
        [fragment systemAccessDetails wrap = SelectableListItemComponent cssClass="type3" canDelete="true" canShare="true" hideDragHandle="true"]
    ]
    trigger = "System"
    fragment systemAccessDetails [
        System: ${name} ${accessedAt replace=CustomActionsComponent placeholder="accessed at"}
        ${description}
    ]
}

SystemAccessReference {
    [
        [fragment systemAccessReferenceDetails wrap = ReferenceComponent cssClass="type3" canDelete="true" canAdd="false" canExpand="false" isExpanded="false" selectable="true" label="System" hideDragHandle="true"]
    ] trigger = "Shared System"
    fragment systemAccessReferenceDetails [
        ${system}
    ]
}

AccessedAtURL {
    [
        ${url replace=UrlInputComponent}
    ] trigger = "Website Address"
}

AccessedAPhoneNumber {
    [
        ${phoneNumber replace=PhoneInputComponent}
    ] trigger = "Phone Number"
}

Person {
    [
        [fragment personDetails wrap = SelectableListItemComponent cssClass="type4" canDelete="true" showDeleteOnHover="true" hideDragHandle="true"]
    ]
    trigger = "Person"
    fragment personDetails [
        ${name} in role: ${role replace=CustomSelectComponent placeholder="role"}
        at ${email replace=EmailInputComponent} or ${phoneNumber replace=PhoneInputComponent}
        ${description}
    ]
}

PersonReference {
    [
        [fragment personReferenceDetails wrap = ReferenceComponent cssClass="type3" canDelete="true" canAdd="false" canExpand="false" isExpanded="false" selectable="true" label="Person" hideDragHandle="true"]
    ] trigger = "Staff"
    fragment personReferenceDetails [
        ${person}
    ]
}

Reference {
    [
        [fragment referenceDetails wrap = SelectableListItemComponent cssClass="type3" canDelete="true" hideDragHandle="true"]
    ]
    fragment referenceDetails [
        Reference: ${name}
        Document is at: ${link replace=UrlInputComponent}
        ${description}
    ]
}

SharedReference {
    [
        [fragment sharedReferenceDetails wrap = ReferenceComponent cssClass="type3" canDelete="true" canAdd="false" canExpand="false" isExpanded="false" selectable="true" label="System" hideDragHandle="true"]
    ] trigger = "Shared Reference"
    fragment sharedReferenceDetails [
        ${referenceName}
    ]
}


StaffRole {
    [
        [fragment roleDetails wrap = SelectableListItemComponent cssClass="type4" canDelete="true" showDeleteOnHover="true" hideDragHandle="true"]
    ]
    trigger = "Role"
    fragment roleDetails [
        ${name}
        ${description}
    ]
}

Description {
    [ ${text replace=MultilineTextComponent} ]
}
