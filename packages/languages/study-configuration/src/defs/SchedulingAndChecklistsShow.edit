editor schedulingAndChecklistsShow precedence 100

Event {
    [ 
        [fragment schedulingAndChecklistsEventDetails wrap = ItemGroupComponent cssClass="type2" canDelete="true" canDuplicate="true" canExpand="true" isExpanded="false" selectable="false" label="Event"]
    ]
    fragment schedulingAndChecklistsEventDetails [
        ${name}
        ${description}
        This is a ${typeOfEvent replace=CustomSelectComponent placeholder="event type"} that is also referred to as ${alternativeName}
        ${schedule wrap=ListGroupComponent cssClass="type3" canExpand="true" isExpanded="false" selectable="false" label="Schedule"}
        ${tasks wrap=ListGroupComponent cssClass="type3" canAdd="true" canDelete="true" canPasteMultiple="true" canExpand="true" isExpanded="false" selectable="false" label="Checklist"}
    ]
}

UnscheduledEvent {
    [
        [fragment unscheduledEventDetailsWithChecklistAndSchedule wrap = ItemGroupComponent cssClass="type2" canDelete="true" canDuplicate="true" canExpand="true" isExpanded="false" selectable="false" label="Event"]
    ]
    fragment unscheduledEventDetailsWithChecklistAndSchedule [
        ${name}
        This is a ${typeOfEvent replace=CustomSelectComponent placeholder="event"} that is also referred to as ${alternativeName}
        ${description}
        ${tasks wrap=ListGroupComponent cssClass="type3" canAdd="true" canDelete="true" canPasteMultiple="true" canExpand="true" isExpanded="false" selectable="false" label="Checklist"}
    ]
}

