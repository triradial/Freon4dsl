editor default

//----------------------------------------------------------
// EVENT SCHEDULE {eventSchedule}
//----------------------------------------------------------

EventSchedule {
    [
        First scheduled ${eventStart replace=CustomActionsComponent placeholder="event start"} 
        ${eventWindow replace=CustomActionsComponent placeholder="with no window"} 
        ${eventRepeat replace=CustomActionsComponent placeholder="with no repetitions"} 
        ${eventTimeOfDay replace=CustomActionsComponent placeholder="with no limit on the time of day"} 
    ] 
    trigger = "event schedule"
} 

EventReference {
    [${event}${eventState replace=CustomSelectComponent placeholder="event state"} ]
    referenceShortcut = ${event}
    }


// EventSchedule {
//     [
//         First scheduled ${eventStart} 
//         [? ${eventWindow} ] 
//         [? and then repeats ${eventRepeat}]
//         [? limited to ${eventTimeOfDay}]
//     ] 
//     trigger = "event schedule"
// } 

//----------------------------------------------------------
// TIME CONCEPTS
//----------------------------------------------------------

Daily {
    [ daily ]
    trigger = "daily"
}

Weekly {
    [ weekly ]
    trigger = "weekly"
}

Monthly {
    [ monthly ]
    trigger = "monthly"
}

Forever {
    [ forever ]
    trigger = "forever"
}

TimeAmount {
    [${value replace=CustomNumericComponent placeholder="#"} ${unit replace=CustomSelectComponent placeholder="unit"} ]
}

TimeAmountPart {
    [${operator replace=CustomSelectComponent placeholder="operator"} ${timeAmount replace=CustomActionsComponent placeholder="time amount"} ]
    trigger = "plus or minus day/week/month/..."
} 

Days {
    [${count replace=CustomNumericComponent}]
}

//----------------------------------------------------------
// EVENT START 
//----------------------------------------------------------

StudyStart {
    [as the start day of the study] 
    trigger = "study start: Declares this event to be the start of the study"
} 

FirstDayOfStudy {
    [ on the start day of the study ${timeAmountPart} ]
    trigger = "start day: Depends on the first day of the study +/- some amount of time"
}

Baseline {
    [ on the baseline/start day of the study ${timeAmountPart} ]
    trigger = "baseline: An alternate name for a reference to the first day of the study"
}

Day {
    [ day ${startDay replace=CustomNumericComponent min="0" max="999"} ]
    trigger = "day: A day of the study"
}

When {
    [ when ${startWhen replace=CustomActionsComponent placeholder="event reference"} ${timeAmountPart replace=CustomActionsComponent placeholder="time amount part"}]
    trigger = "when: Depends on when another event occurs"
}  

Previous {
    [ when the previous event ${eventState} ${timeAmountPart} ]
    trigger = "previous: Depends on the previous event"
}

Unscheduled {
    [ on any day (an unscheduled event) ]
    trigger = "unscheduled: An unscheduled event"
}

AnyDay {
    [ on any day (an unscheduled event) ]
    trigger = "any day: An alternative name for an unscheduled event"
} 


//----------------------------------------------------------
// WINDOWS
//----------------------------------------------------------


EventWindow {
    [
        with a window of ${daysBefore replace=CustomNumericComponent min="0" max="30"} day(s) before and ${daysAfter replace=CustomNumericComponent min="0" max="30"} day(s) after
        ${complianceWindow replace=CustomActionsComponent placeholder="with no compliance window"} 
    ] trigger = "event window"
}

ComplianceWindowOf {
    [
    and a compliance window of ${maxDaysBefore replace=CustomNumericComponent min="0" max="30"} additional day(s) before and ${maxDaysAfter replace=CustomNumericComponent min="0" max="30"} day(s) after
    ] trigger = "time before/after to be compliant"
}

//----------------------------------------------------------
// EVENT TIME OF DAY
//----------------------------------------------------------

BetweenTimes {
    [
        starting by ${startTimeAsString replace=CustomTimePickerComponent} and ending by ${endTimeAsString replace=CustomTimePickerComponent}
    ] 
    trigger = "between times: Times of day event must start and end"
}   

StartingBy {
    [
        starting by ${startTimeAsString replace=CustomTimePickerComponent}
    ] 
    trigger = "starting by: Time of day event must start"
} 

EndingBy {
    [
        ending by ${endTimeAsString replace=CustomTimePickerComponent}
    ] 
    trigger = "ending by: Time of day event must end"
} 


//----------------------------------------------------------
// REPEAT
//----------------------------------------------------------

RepeatEvery {
    [ repeats every: ${repeatEvery} ]
    trigger = "every"
}

RepeatCondition {
    [   
        repeats ${repeatUnit replace=CustomSelectComponent placeholder="frequency"} up to ${maxRepeats replace=CustomNumericComponent min="2" max="999" defaultValue="1"} times [? until ${until}] 
    ] trigger = "until: Repeat until a condition occurs"
} 

RepeatCount {
    [
        repeats ${repeatCount replace=CustomNumericComponent min="1" max="999" defaultValue="1"} time(s)  
    ] 
    trigger = "count: Repeat a specific number of times"
} 
