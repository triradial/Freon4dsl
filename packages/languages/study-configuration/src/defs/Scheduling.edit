EventSchedule {
    [
        First scheduled ${eventStart} 
        ${eventWindow} 
        and then repeats ${eventRepeat replace=CustomActionsComponent placeholder="repeat expression"} 
        limited to ${eventTimeOfDay replace=CustomActionsComponent placeholder="time"} 
    ] 
    trigger = "event schedule"
} 

EventReference {
    [${event}${eventState replace=CustomSelectComponent placeholder="event state"} ]
    referenceShortcut = ${event}
    }

Days {
    [${count replace=CustomNumericComponent}]
}