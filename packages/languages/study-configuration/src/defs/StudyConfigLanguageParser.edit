editor parser

StudyConfiguration {
    [
    Periods:
      ${periods}
    Tasks:
      ${tasks}
    System Accesses:
      ${systemAccesses}
    Staffing:
      ${staffing}
    Roles:
      ${roles}
    Notes:
      ${description}
    ]
}

//boolean [YES | NO] // are the strings used to display a boolean value

Period {
    [ 
        Period:${name}
        ${description}
        Scheduled Events:
          ${events}
        Unscheduled Events:
          ${unscheduledEvents}
    ]   
}

Event {
    [ 
        Event:${name}
        This is a ${typeOfEvent} [? that is also referred to as ${alternativeName} ]
        ${description}
        Schedule:
          ${schedule}
        Tasks:
          ${tasks}
    ]
}

SharedTask {
    [
        Shared Task:${name}
        ${description}
        Steps:
          ${steps}
    ]
}

Task {
    [
        Task:${name}
        ${description}
        Steps:
          ${steps}
    ]
}

TaskReference {
    [
        TaskReference:${task}
    ]
}

Step {
    [
        Step:${name}
        ${description}
        People:
            ${people}
        Systems Used:
            ${systems}
        References:
            ${references}
    ]
}

SystemAccess {
    [
        System Name:${name}
        Accessed At:${accessedAt}
        ${description}
    ]
}

SystemAccessReference {
    [
        SystemAccessReference:${system}
    ]
}

AccessedAtURL {
    [
        URL: ${url}
    ]
}

AccessedAPhoneNumber {
    [
        Phone Number: ${phoneNumber}
    ]
}

Person {
    [
        Name:${name}
        Email: ${email}
        Phone: ${phoneNumber}
        Role: ${role}
        Notes:${description}
    ]
}

PersonReference {
    [
        PersonReference:${person}
    ]
}


Reference {
    [
    Reference:${name} 
    Document is at: ${link}
    ${description}
    ]
}

StaffRole {
    [
        Role:${name} 
        ${description}
    ]
}

Description {
    [ [? Description:${rawText} ] ]
}
