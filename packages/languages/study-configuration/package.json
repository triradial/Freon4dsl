{
  "name": "@freon4dsl/study-configuration",
  "version": "2.0.0",
  "license": "MIT",
  "main": "dist/index.custom.js",
  "module": "dist/index.custom.js",
  "types": "dist/index.custom.d.ts",
  "type": "module",
  "scripts": {
    "test": "vitest run -c ./vitest.config.ts",
    "test:watch": "vitest -c ./vitest.config.ts",
    "coverage": "vitest run --coverage -c ./vitest.config.ts",
    "clean": "rm -rf node_modules/",
    "build": "npm run generate && tsc && vite build",
    "nogen": "tsc && vite build",
    "install-local": "npm install --registry http://localhost:4873",
    "generate": "bash ../../../scripts/freon-samples-dev.sh -v all -d src/defs -o src/",
    "clean-gen": "bash ../../../scripts/freon-samples-dev.sh clean-it -d src/defs -o src",
    "clean-config": "rm */config/FreonConfiguration.ts",
    "clean-custom": "rm */*/Custom*.ts"
  },
  "dependencies": {
    "@freon4dsl/core": "2.0.0",
    "@types/node": "^24.0.0",
    "kotlin": "^1.5.21",
    "lodash": "^4.17.21",
    "mobx": "^6.12.3",
    "mobx-utils": "^6.0.8",
    "net.akehurst.language-agl-processor": "4.2.1-20-RC2",
    "tslib": "^2.6.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.7",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.14",
    "@vitest/coverage-v8": "^2.1.3",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^25.0.1",
    "ts-jest": "^29.1.5",
    "typescript": "5.9.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.3"
  }
}
