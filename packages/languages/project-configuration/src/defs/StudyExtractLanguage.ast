language StudyExtractModel

// Structure aligned with packages/languages/project-configuration/src/defs/StudyExtract.ini

model StudyExtractModel {
    extract: StudyExtract;
}

modelunit StudyExtract {
    references: References;
    topics: Topic[];
    description: Description;
}

concept References {
    name: string;
    study: Study;
    bibliography: BibliographyTable;
    arm: Arm;
}

concept Study {
    columns: Column[];
    description: Description;
}

concept BibliographyTable {
    rootColumns: Column[];
    rows: BibliographyRow[];
    description: Description;
}

concept Arm {
    table: Table;
    description: Description;
}

concept Topic {
    name: string;
    overview: Description;
    details: Description;
    tables: Table[];
}

concept Table {
    name: string;
    rootColumns: Column[];
    description: Description;
}

concept Column {
    name: string;
    subcolumns: Column[];
    description: Description;
    dataType: string;
}

concept StudyRow {
    cellValues: CellValue[];
}

concept BibliographyRow {
    cellValues: CellValue[];
}

concept ArmRow {
    cellValues: CellValue[];
}

concept TableRow {
    cellValues: CellValue[];
}

concept CellValue {
    columnPath: string;
    value: string;
}

concept Description {
    text: string = " ";
    rawText: string = " ";
}

concept DateConcept {
    dateAsString: string;
    day: number;
    month: number;
    year: number;
}

concept DateRange {
    startDate: DateConcept;
    endDate: DateConcept;
}

