editor default

ProjectConfiguration {
    [
        Name: ${name}
        Descriptions:
        ${description}
        Events:
        ${events}
        Tasks:
        ${tasks}
        Periods:
        ${periods}
    ]
}

Description {
    [ ${rawText} ]
}

Event {
    [
        Name: ${name}
        Start Date: ${startDate}
        End Date: ${endDate}
        Tasks: ${tasks}
    ]
}

Task {
    [
        Name: ${name}
        Duration: ${duration}
        Priority: ${priority}
        Assigned To: ${assignedTo}
        Status: ${status}
    ]
}

TaskReference {
    [
        Task: ${task}
        Start Date: ${startDate}
        End Date: ${endDate}
    ]
}

Period {
    [
        Name: ${name}
        Start Date: ${startDate}
        End Date: ${endDate}
        Events: ${events}
    ]
}

DateConcept {
    [ ${day}/${month}/${year} ]
}

DateRange {
    [
        Start: ${startDate}
        End: ${endDate}
    ]
}