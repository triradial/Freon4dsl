<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="dist/server/start.cjs" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <!-- First rule for static files if they exist -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}" />
        </rule>
        <!-- All other requests go to our Node app -->
        <rule name="DynamicContent">
          <match url="/*" />
          <action type="Rewrite" url="dist/server/start.cjs" />
        </rule>
      </rules>
    </rewrite>
    <iisnode
      nodeProcessCommandLine="&quot;%programfiles%\nodejs\node.exe&quot;"
      debuggingEnabled="true"
      loggingEnabled="true"
      logDirectory="..\..\LogFiles\nodejs"
      watchedFiles="*.js;web.config"
    />
  </system.webServer>
</configuration>