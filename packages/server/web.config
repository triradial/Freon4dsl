<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="dist/server/start.cjs" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="dist/server/start.cjs" />
        </rule>
      </rules>
    </rewrite>
    <iisnode 
      nodeProcessCommandLine="node"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="true"
      debugHeaderEnabled="true"
      devErrorsEnabled="true"
      debuggerExtensionDll=""
      promoteServerVars=""
      watchedFiles="*.js;*.cjs"
      nodeProcessCountPerApplication="1"
      maxLogFiles="50"
      appendToExistingLog="true"
    />
    <!-- Add detailed error pages -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>