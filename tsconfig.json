{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "allowJs": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "removeComments": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "nodenext",
    "types": [
      "node",
      "svelte"
    ],
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@freon4dsl/core": ["packages/core/src"],
      "@freon4dsl/core-svelte": ["packages/core-svelte/src"]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "es6",
      "es2017",
      "es2019"
    ]
  },
  "references": [
    { "path": "packages/core" },
    { "path": "packages/core-svelte" }
  ],
  "exclude": [
    "**/dist",
    "**/node_modules"
  ],
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  }
}
